# This file documents planned names only. No application currently reads these values.

# Browser-visible values. Never place secrets in a VITE_ variable.
VITE_API_BASE_URL=http://localhost:8000
VITE_DATA_MODE=demo

# Planned server-side configuration.
SPARC_DATA_MODE=demo
SPARC_DEMO_DATA_ROOT=./data/demo
SPARC_ALLOWED_ORIGINS=http://localhost:5173

# Optional Copernicus Data Space credentials for future server-side acquisition.
# Leave blank in demo mode. Never expose these through VITE_ variables or logs.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

