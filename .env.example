# Copy to an ignored .env only when your launcher loads it. The API reads server values
# from the process environment; it does not load this file or print secret values.

# Browser-visible values. Never place secrets in a VITE_ variable.
VITE_API_BASE_URL=http://localhost:8000
VITE_DATA_MODE=demo

# Planned server-side configuration.
SPARC_DATA_MODE=demo
# Use the reviewed Earth Engine packs for the API path:
# SPARC_DATA_MODE=precomputed
SPARC_DEMO_DATA_ROOT=./data/demo
SPARC_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8123
SPARC_MAX_REQUEST_BYTES=65536
SPARC_COMPARISON_REQUESTS_PER_MINUTE=60

# Google Earth Engine project for server-side/offline processing only.
# Do not expose it through VITE_ variables; credentials remain in Earth Engine's local user config.
EARTH_ENGINE_PROJECT=

# Optional server-side Gemini drafting. Never expose this through VITE_ variables
# or commit the value. Reports add sensitive complainant details locally after
# the Gemini draft returns.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
